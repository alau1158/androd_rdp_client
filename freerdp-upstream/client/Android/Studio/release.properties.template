# Copy to release.properties and fill in your own values.
# release.properties is git-ignored because it holds signing credentials.
COMPILE_API=37
TARGET_API=37
MIN_API=29
TOOLS_VERSION=37.0.0
NDK_VERSION=29.0.13113456
CMAKE_VERSION=4.1.2
ABI_FILTERS=arm64-v8a
SPLIT_ARCHITECTURES=arm64-v8a
SPLIT_ENABLED=false
BUILD_UNIVERSAL=true
VERSION_NAME=1.0.14
VERSION_CODE=14
CMAKE_ARGUMENTS=-DWITH_FFMPEG=OFF;-DWITH_OPENH264=ON;-DWITH_OPUS=ON;-DWITH_WEBP=OFF;-DWITH_JPEG=OFF;-DWITH_PNG=ON;-DWITH_CJSON=ON;-DWITH_OPENSSL=ON
RELEASE_STORE_FILE=/path/to/your/release.jks
RELEASE_KEY_ALIAS=yourkeyalias
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_PASSWORD=changeme
