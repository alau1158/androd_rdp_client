<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (API 37) Local Network Protection: without this runtime
         permission, all TCP/UDP to LAN addresses is silently dropped. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the session window capture system shortcuts (Windows/Super key, Alt+Tab,
         ...) instead of letting the OS/DeX consume them. Normal install-time permission
         on Android 16.1+. -->
    <uses-permission android:name="android.permission.CAPTURE_KEYBOARD" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.keyboard" android:required="false" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:xlargeScreens="true" />

    <application
        android:name=".DexRdpApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.DexRdp"
        tools:replace="android:theme">

        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DexRdp"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout|navigation"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The library declares this accessibility service as exported="false",
             which stops Android listing it under Settings > Accessibility. The
             system must be able to bind to it, so force it exported. -->
        <activity
            android:name=".engine.RdpSessionActivity"
            android:exported="false"
            android:theme="@style/Theme.DexRdp"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|density|screenLayout|navigation"
            android:windowSoftInputMode="adjustResize">
            <!-- Same DeX delay as the FreeRDP session activity (no effect on One UI 9). -->
            <meta-data
                android:name="com.samsung.android.dex.transient_bar_delay"
                android:value="5000" />
        </activity>

        <service
            android:name="com.freerdp.freerdpcore.presentation.KeyboardAccessibilityService"
            android:label="DeX RDP Physical Keyboard"
            android:exported="true"
            tools:replace="android:exported,android:label" />
    </application>
</manifest>